# Copy to .env; never commit real credentials.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
SUPPORT_DB_PATH=.data/leandesk.sqlite
SUPPORT_KNOWLEDGE_PATH=knowledge/runbooks.json
SUPPORT_SEARCH_BACKEND=auto
# Separate admin keys, at least 32 characters. Never reuse a support API token.
SUPPORT_ADMIN_IDENTITIES_JSON=[]
# Set the external HTTPS origin and secure cookie flag behind a reverse proxy.
# SUPPORT_ADMIN_ORIGIN=https://support.example.com
# SUPPORT_ADMIN_SECURE_COOKIE=true
# Server-side identity bindings. Matching ids link explicitly approved channels.
SUPPORT_IDENTITIES_JSON=[{"channel":"api","subject":"replace-with-random-token","id":"alice","tenant":"demo","scopes":["it"]}]
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
